{
    "name": "kgaut/github_api",
    "type": "drupal-module",
    "description": "Integrates your Drupal site with GitHub through the KnpLabs GitHub API client.",
    "keywords": [
        "Drupal",
        "Github",
        "API"
    ],
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/kgaut/github_api",
    "authors": [
        {
            "name": "Kevin Gautreau",
            "homepage": "https://kgaut.net"
        }
    ],
    "support": {
        "issues": "https://github.com/kgaut/github_api/issues",
        "source": "https://github.com/kgaut/github_api"
    },
    "require": {
        "php": ">=8.1",
        "knplabs/github-api": "^3.16"
    },
    "require-dev": {
        "drupal/coder": "^8.3",
        "drupal/core": "^10.3 || ^11",
        "guzzlehttp/guzzle": "^7.8",
        "http-interop/http-factory-guzzle": "^1.2",
        "phpstan/phpstan": "^2.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\github_api\\": "src/"
        }
    },
    "scripts": {
        "phpcs": "phpcs --standard=Drupal,DrupalPractice --extensions=php,module,inc,install,yml --ignore=vendor/* src github_api.info.yml github_api.services.yml github_api.routing.yml github_api.links.menu.yml github_api.permissions.yml",
        "phpstan": "phpstan analyse --no-progress",
        "qa": [
            "@phpcs",
            "@phpstan"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true,
            "symfony/runtime": false,
            "drupal/core-composer-scaffold": false,
            "drupal/core-project-message": false,
            "phpstan/extension-installer": true
        }
    }
}
